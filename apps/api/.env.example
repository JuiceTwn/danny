NODE_ENV=development
PORT=8787
# Runtime role (restricted; row-level security applies to it)
DATABASE_URL=postgres://danny_app:change-me@localhost:5432/danny
# Table owner, used only by `npm run db:migrate` and `npm run create-owner`
MIGRATE_DATABASE_URL=postgres://danny_owner:change-me@localhost:5432/danny
# Encrypts memory, messages, drafts and connection secrets. Generate: echo "1:$(openssl rand -base64 32)"
# Back it up separately from the database. To rotate, ADD "2:<new key>" and keep the old one.
DATA_KEYS=
# Folder with the built web app (npm run build -w @danny/web). Defaults to ../web/dist
WEB_DIR=
APP_URL=http://localhost:8787
APP_ORIGINS=http://localhost:8787
MARKETING_ORIGINS=http://localhost:8123
COOKIE_SECURE=false
TRUST_PROXY=false
DEFAULT_DAILY_CAP_USD=1
OWNER_DAILY_CAP_USD=5
MAX_DAILY_CAP_USD=50
# Placeholders: check against Anthropic's current pricing before real traffic
PRICE_INPUT_PER_MTOK_USD=1
PRICE_OUTPUT_PER_MTOK_USD=5

# Keys can also be pasted in the app: Owner tab, API keys. A key set here wins and can't be changed there.
# Voice typing (the mic button in chat). Leave blank and the button stays hidden.
# Get a key at elevenlabs.io. Put it here on the server, never in chat or in git.
ELEVENLABS_API_KEY=
# STT_MODEL=scribe_v2
# PRICE_STT_PER_HOUR_USD=0.22   # check ElevenLabs' current price; every recording is billed against the daily cap

# Call mode (the Call button in chat) uses the same ElevenLabs key. Danny's voice is any ElevenLabs voice ID (library, or one you made).
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# TTS_MODEL=eleven_flash_v2_5            # a low-latency model; check it is valid for your account
# PRICE_TTS_PER_1K_CHARS_USD=0.05        # placeholders: check ElevenLabs' current prices
# PRICE_STT_LIVE_PER_HOUR_USD=0.39
# CALL_MAX_MINUTES=10                    # longest single call. The daily allowance also stops a call.
